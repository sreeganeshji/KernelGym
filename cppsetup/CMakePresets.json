{
    "version": 8,
    "configurePresets": [
        {
            "name": "gbangalore-dev0",
            "binaryDir": "${sourceDir}/Build",
            "cacheVariables": {
                "CMAKE_CUDA_COMPILER": "/usr/local/cuda-12.6/bin/nvcc",
                "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-13",
                "CMAKE_CUDA_ARCHITECTURES": "61"
            }
        },
        {
            "name": "3080Ti",
            "binaryDir": "${sourceDir}/Build",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "/usr/bin/g++-14",
                "CMAKE_CUDA_COMPILER": "/usr/local/cuda-13.3/bin/nvcc",
                "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-14",
                "CMAKE_CUDA_ARCHITECTURES": "86"
            }
        },
        {
            "name": "MSI",
            "binaryDir": "${sourceDir}/Build",
            "cacheVariables": {
                "CMAKE_CUDA_ARCHITECTURES": "89",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++-15",
                "CMAKE_CUDA_COMPILER": "/usr/local/cuda-13.3/bin/nvcc",
                "CMAKE_CUDA_HOST_COMPILER": "/usr/bin/g++-15"
            }
        }
    ]
}